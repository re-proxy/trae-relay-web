# Copy to .env. Generate each value independently. Never commit .env.
RELAY_ADMIN_PASSWORD=
# Standard base64 of exactly 32 random bytes; e.g. openssl rand -base64 32
RELAY_MASTER_KEY=
RELAY_PORT=8317
RELAY_MAX_CONCURRENT=2
# Set true behind an HTTPS reverse proxy; keep false for localhost SSH tunnel.
RELAY_SECURE_COOKIE=false
TRAE_IDE_VERSION=3.4.0
TRAE_IDE_VERSION_CODE=20260919
